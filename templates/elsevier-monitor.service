[Unit]
Description=Elsevier AuthorHub Submission Monitor
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=600
StartLimitBurst=5

[Service]
Type=simple
User=elsevier-monitor
Group=elsevier-monitor
WorkingDirectory=/opt/elsevier-monitor
EnvironmentFile=/etc/elsevier-monitor.env
Environment=HOME=/var/lib/elsevier-monitor
ExecStart=/opt/elsevier-monitor/.venv/bin/python /opt/elsevier-monitor/monitor.py --daemon
Restart=always
RestartSec=30
TimeoutStopSec=20
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/var/lib/elsevier-monitor /var/log/elsevier-monitor
TasksMax=256
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
